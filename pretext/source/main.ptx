<?xml version='1.0' encoding='utf-8'?>
<!-- This is the main file of the PreTeXt version of the R Markdown Cookbook. -->
<!-- The main.ptx file starts with <pretext> tags. Content is organized       -->
<!-- into separate .ptx files which are included via xi:include.              -->

<pretext xml:lang="en-US" xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- we first include a file which contains the docinfo element: -->
  <xi:include href="./meta_docinfo.ptx" />

  <!-- The <book> tags wrap all the content. -->
  <book xml:id="rmarkdown-cookbook">
    <title>R Markdown Cookbook</title>
    <subtitle>Practical Tips and Tricks for R Markdown</subtitle>

    <!-- Front matter: preface, about the authors, abstract -->
    <xi:include href="./meta_frontmatter.ptx" />

    <!-- Chapter 1: Installation -->
    <xi:include href="./ch_intro.ptx" />

    <!-- Chapter 2: Conceptual Overview -->
    <xi:include href="./ch_overview.ptx" />

    <!-- Chapter 3: Basics -->
    <xi:include href="./ch_basics.ptx" />

    <!-- Chapter 4: Document Elements -->
    <xi:include href="./ch_content.ptx" />

    <!-- Chapter 5: Formatting -->
    <xi:include href="./ch_formatting.ptx" />

    <!-- Chapter 6: LaTeX Output -->
    <xi:include href="./ch_latex.ptx" />

    <!-- Chapter 7: HTML Output -->
    <xi:include href="./ch_html.ptx" />

    <!-- Chapter 8: Word -->
    <xi:include href="./ch_word.ptx" />

    <!-- Chapter 9: Multiple Output Formats -->
    <xi:include href="./ch_multiformat.ptx" />

    <!-- Chapter 10: Tables -->
    <xi:include href="./ch_tables.ptx" />

    <!-- Chapter 11: Chunk Options -->
    <xi:include href="./ch_chunk-options.ptx" />

    <!-- Chapter 12: Output Hooks -->
    <xi:include href="./ch_output-hooks.ptx" />

    <!-- Chapter 13: Chunk Hooks -->
    <xi:include href="./ch_chunk-hooks.ptx" />

    <!-- Chapter 14: Miscellaneous knitr Tricks -->
    <xi:include href="./ch_knitr-misc.ptx" />

    <!-- Chapter 15: Other Languages -->
    <xi:include href="./ch_languages.ptx" />

    <!-- Chapter 16: Managing Projects -->
    <xi:include href="./ch_projects.ptx" />

    <!-- Chapter 17: Workflow -->
    <xi:include href="./ch_workflow.ptx" />

    <!-- Back matter: references and index -->
    <xi:include href="./meta_backmatter.ptx" />
  </book>
</pretext>
